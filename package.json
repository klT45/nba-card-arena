    "retier": "node scripts/pyrun.mjs scripts/retier.py",
    "probe:commons": "node scripts/pyrun.mjs scripts/probe_commons.py --slugs",
    "doctor": "node scripts/doctor.mjs",
    "draw:stats": "node scripts/draw-stats.cjs",
    "draw:anim": "node scripts/draw-anim.cjs",
    "shot:pages": "node scripts/shot-pages.cjs",
    "shot:admin": "node scripts/shot-admin.cjs",
    "shot:devices": "node scripts/shot-devices.cjs",
    "shot:sheet": "node scripts/pyrun.mjs scripts/device_sheet.py",
    "test:rarity": "node scripts/test-rarity-edit.cjs",
    "test:exports": "node scripts/test-exports.cjs",
    "test:tokens": "node scripts/test-tokens.cjs",
    "test:lineup": "node scripts/test-lineup-integrity.cjs",
    "test:controls": "node scripts/test-controls-sync.cjs",
    "test:escaping": "node scripts/test-escaping.cjs",
    "test:reduced": "node scripts/test-reduced-motion.cjs",
    "test:admin": "node scripts/test-admin-api.cjs",
    "test": "node scripts/test-escaping.cjs && node scripts/test-tokens.cjs",
