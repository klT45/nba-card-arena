    "cutouts": "node scripts/pyrun.mjs scripts/make_cutouts.py",
    "build:cards": "node scripts/pyrun.mjs scripts/build_cards.py",
    "contact-sheet": "node scripts/pyrun.mjs scripts/contact_sheet.py",
