    "visual": "node scripts/draw-anim.cjs && node scripts/shot-pages.cjs && node scripts/shot-admin.cjs && node scripts/shot-devices.cjs",
    "check": "npm run test && npm run test:e2e && npm run visual",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:holo": "node scripts/test-holo-lifecycle.cjs",
    "test:a11y": "node scripts/test-a11y.cjs"
